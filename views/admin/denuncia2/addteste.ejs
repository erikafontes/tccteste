<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Denúncias Ambientais - Administração</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <div class="header-left">
                <button class="menu-btn" id="menuBtn">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <h1>Sistema de Denúncias Ambientais</h1>
            </div>
            <button class="btn btn-white" onclick="showPage('form')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Nova Denúncia</span>
            </button>
        </div>
    </header>

    <div class="main-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <nav class="sidebar-nav">
                <a href="#" class="nav-item active" onclick="showPage('list')">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Denúncias</span>
                </a>
                <a href="#" class="nav-item" onclick="showPage('reports')">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span>Relatórios</span>
                </a>
            </nav>
        </aside>

        <!-- Overlay -->
        <div class="overlay" id="overlay"></div>

        <!-- Main Content -->
        <main class="content">
         
            <!-- Página de Formulário -->
            <div id="formPage" class="page">
                <div class="page-header">
                    <button class="btn-back" onclick="showPage('list')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                    </button>
                    <h2>Nova Denúncia</h2>
                </div>

                <form class="form" id="denunciaForm">
                    <!-- Informações da Denúncia -->
                    <div class="card">
                        <div class="card-header">
                            <h3>Informações da Denúncia</h3>
                            <p class="card-description">Dados básicos da denúncia registrada</p>
                        </div>
                        <div class="card-content">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="ndenuncia">Número da Denúncia</label>
                                    <input type="text" id="ndenuncia" value="ndenuncia" disabled>
                                </div>
                                <div class="form-group">
                                    <label for="fonte">Fonte</label>
                                    <select id="fonte" required>
                                        <option value="WhatsApp">WhatsApp</option>
                                        <option value="Telefonema">Telefonema</option>
                                        <option value="Email">Email</option>
                                        <option value="Presencial">Presencial</option>
                                        <option value="Site">Site</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="data">Data</label>
                                    <input type="date" id="data" required>
                                </div>
                                <div class="form-group">
                                    <label for="hora">Hora</label>
                                    <input type="time" id="hora" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dados do Denunciante -->
                    <div class="card">
                        <div class="card-header">
                            <h3>Dados do Denunciante</h3>
                            <p class="card-description">Informações da pessoa que registrou a denúncia</p>
                        </div>
                        <div class="card-content">
                            <div class="form-group">
                                <label for="nomeDenunciante">Nome Completo</label>
                                <input type="text" id="nomeDenunciante" required>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="cpf">CPF</label>
                                    <input type="text" id="cpf" placeholder="000.000.000-00" required>
                                </div>
                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" id="email" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="endereco">Endereço do Local</label>
                                <input type="text" id="endereco" required>
                            </div>
                        </div>
                    </div>

                    <!-- Detalhes da Ocorrência -->
                    <div class="card">
                        <div class="card-header">
                            <h3>Detalhes da Ocorrência</h3>
                            <p class="card-description">Informações específicas sobre a denúncia</p>
                        </div>
                        <div class="card-content">
                            <div class="form-grid-3">
                                <div class="form-group">
                                    <label for="especie">Espécie</label>
                                    <select id="especie" required>
                                        <option value="Animais">Animais</option>
                                        <option value="Ambiental">Ambiental</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="quantidade">Quantidade</label>
                                    <input type="number" id="quantidade" min="1" value="1" required>
                                </div>
                                <div class="form-group">
                                    <label for="situacao">Situação</label>
                                    <select id="situacao" required>
                                        <option value="Pendente">Pendente</option>
                                        <option value="Em Análise">Em Análise</option>
                                        <option value="Em Andamento">Em Andamento</option>
                                        <option value="Resolvida">Resolvida</option>
                                        <option value="Arquivada">Arquivada</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="foto">Foto/Evidência</label>
                                <div class="upload-box">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="17 8 12 3 7 8"></polyline>
                                        <line x1="12" y1="3" x2="12" y2="15"></line>
                                    </svg>
                                    <p>Clique para fazer upload ou arraste a imagem aqui</p>
                                    <input type="file" id="foto" accept="image/*">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dados do Denunciado -->
                    <div class="card">
                        <div class="card-header">
                            <h3>Dados do Denunciado</h3>
                            <p class="card-description">Informações sobre o suspeito/responsável</p>
                        </div>
                        <div class="card-content">
                            <div class="form-group">
                                <label for="nome">Nome do Denunciado</label>
                                <input type="text" id="nome" placeholder="Nome ou razão social">
                            </div>
                            <div class="form-group">
                                <label for="enderecoProprietario">Endereço do Denunciado</label>
                                <input type="text" id="enderecoProprietario">
                            </div>
                        </div>
                    </div>

                    <!-- Providências -->
                    <div class="card">
                        <div class="card-header">
                            <h3>Providências Tomadas</h3>
                            <p class="card-description">Ações realizadas pela equipe</p>
                        </div>
                        <div class="card-content">
                            <div class="form-group">
                                <textarea id="providencia" rows="5" placeholder="Descreva as providências tomadas..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-outline" onclick="showPage('list')">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Cadastrar Denúncia</button>
                    </div>
                </form>
            </div>

          
        </main>
    </div>

    <script src="script.js"></script>
</body>
</html>
