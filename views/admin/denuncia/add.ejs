<%- include('../cabecalho.ejs') %>

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Melhorar Elenco</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
  </head>

  <body>


    <form action="/admin/denuncia/add" method="post" enctype="multipart/form-data">

      <label for="ndenuncia"></i> N° da Denuncia:</label>
      <input type="number" id="ndenuncia" name="ndenuncia" >

      <label for="fonte"></i> Fonte da Denuncia:</label>
      <input type="text" id="fonte" name="fonte" placeholder="Digite a Fonte da Denuncia">

  <div class="linha">
  
    <div class="campo">
      <label>Data da Denúncia:</label>
      <input type="date" id="data" name="data">
    </div>

    <div class="campo">
      <label>Horário da Denúncia:</label>
      <input type="time" id="hora" name="hora">
    </div>

  </div>


                        <h1> 2. DADOS DA DENÚNCIA:</h1>  <!-- //2.dados da denuncia -->

      <label for="endereco"></i> Endereço da Denuncia:</label>
      <input type="text" id="endereco" name="endereco">

      <label for="especie"></i> Espécie da Denuncia:</label>
      <input type="text" id="especie" name="especie">

        <label for="quantidade"></i> Quantidade:</label>
      <input type="number" id="quantidade" name="quantidade">

        <label for="situacao"></i> Situação da Denuncia:</label>
      <input type="text" id="situacao" name="situacao" placeholder="Descreva a Situação">

      <label for="foto"> Registro do Ocorrido:</label>
      <input type="file" id="foto" name="foto">

                            <h1> 3. DADOS DO PROPRIETÁRIO</h1><!-- 3.dados do proprietário -->

      <label for="nome"></i> Nome do Proprietário:</label>
      <input type="text" id="nome" name="nome" placeholder="Digite o nome do proprietário">

      <label for="cpf"></i> CPF do Proprietário:</label>
      <input type="text" id="cpf" name="cpf" placeholder="Digite o CPF do proprietário">

      <label for="telefone"></i> Telefone do Proprietário:</label>
      <input type="text" id="telefone" name="telefone" placeholder="Digite o telefone do proprietário">


      <label for="enderecoProprietario"></i> Endereço do Proprietário:</label>
      <input type="text" id="enderecoProprietario" name="enderecoProprietario" placeholder="Digite o endereço do proprietário">

                           <h1> 4. PROVIDÊNCIAS REALIZADAS PELA POLÍCIA:</h1>

        <label for="providencias"></i> Providências:</label>
      <input type="text" id="providencias" name="providencias" placeholder="Digite as providências tomadas">




      <button type="submit">Finalizar</button>
    </form>
  </body>

  </html>