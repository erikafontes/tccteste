<%- include('../cabecalho2.ejs') %>
 <!-- Página de Listagem -->
            <div id="listPage" class="page active">
                <div class="page-header">
                    <h2>Gerenciar Denúncias</h2>
                </div>

                <!-- Filtros -->
                <div class="filters-card">
                    <div class="filters-grid">
                        <div class="search-box">
                            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="m21 21-4.35-4.35"></path>
                            </svg>
                            <input type="text" placeholder="Buscar por número, denunciante ou denunciado..." id="searchInput">
                        </div>
                        <select id="filterSituacao">
                            <option value="todas">Todas as situações</option>
                            <option value="Pendente">Pendente</option>
                            <option value="Em Análise">Em Análise</option>
                            <option value="Em Andamento">Em Andamento</option>
                            <option value="Resolvida">Resolvida</option>
                            <option value="Arquivada">Arquivada</option>
                        </select>
                        <select id="filterEspecie">
                            <option value="todas">Todas as espécies</option>
                            <option value="Animais">Animais</option>
                            <option value="Ambiental">Ambiental</option>
                        </select>
                    </div>
                </div>

                <div class="results-count" id="resultsCount">Exibindo 8 de 8 denúncias</div>

                <!-- Tabela -->
                <div class="table-card">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Denunciante</th>
                                <th>Data/Hora</th>
                                <th>Espécie</th>
                                <th>Situação</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <!-- Será preenchido pelo JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script>
        const denuncias = [
     <%Denuncias.forEach(function(denuncia){ %>
        {
        id: '<%=denuncia._id %>',
       
        numero: '<%=denuncia.ndenuncia %>',
        nomeDenunciante: '<%=denuncia.nomedenunciante %>',
        cpf: '<%=denuncia.cpf %>',
        email: '<%=denuncia.email %>',
        fonte: '<%=denuncia.fonte %>',
        data: '<%=denuncia.data %>',
        hora: '<%=denuncia.hora %>',
        endereco: '<%=denuncia.endereco %>',
        especie: '<%=denuncia.especie %>',
        quantidade: '<%=denuncia.quantidade %>',
        situacao: '<%=denuncia.situacao %>',
        nomeDenunciado: '<%=denuncia.nome %>',
        enderecoProprietario: '<%=denuncia.enderecoProprietario %>',
        providenciasTomadas: '<%=denuncia.providencia %>'
    },
  <% }) %>
    ]

    </script>
    <script src="/script.js"></script>

<%- include('../rodape.ejs') %>
