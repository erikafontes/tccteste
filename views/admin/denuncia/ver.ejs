<%- include('../cabecalho2.ejs', { currentSection: 'denuncia' }) %>
<% const isAdminFlag = typeof isAdmin === 'undefined' ? true : isAdmin; %>
<% const basePath = isAdminFlag ? '/admin' : '/usuario'; %>
<div id="viewPage" class="page active">
    <div class="page-header">
        <button class="btn-back" type="button" onclick="window.location.href='<%= basePath %>/denuncia/lst'">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
        </button>
        <h2>Visualizar Denúncia</h2>
    </div>

    <form class="form denuncia-case-form" action="<%= isAdminFlag ? `/admin/denuncia/edt/${Denuncia._id}` : '#' %>" method="POST" enctype="multipart/form-data">
        <div class="card">
            <div class="card-header">
                <h3>Informacoes da Denúncia</h3>
                <p class="card-description">Dados básicos da denúncia registrada</p>
            </div>
            <div class="card-content">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="ndenuncia">Numero da Denúncia</label>
                        <input type="number" id="ndenuncia" name="ndenuncia" value="<%= Denuncia.ndenuncia %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="fonte">Fonte</label>
                        <select id="fonte" name="fonte" disabled>
                            <option value="WhatsApp" <%= Denuncia.fonte === 'WhatsApp' ? 'selected' : '' %>>WhatsApp</option>
                            <option value="Telefonema" <%= Denuncia.fonte === 'Telefonema' ? 'selected' : '' %>>Telefonema</option>
                            <option value="Email" <%= Denuncia.fonte === 'Email' ? 'selected' : '' %>>Email</option>
                            <option value="Presencial" <%= Denuncia.fonte === 'Presencial' ? 'selected' : '' %>>Presencial</option>
                            <option value="Site" <%= Denuncia.fonte === 'Site' ? 'selected' : '' %>>Site</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="data">Data</label>
                        <input type="date" id="data" name="data" value="<%= Denuncia.data ? new Date(Denuncia.data).toISOString().split('T')[0] : '' %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="hora">Hora</label>
                        <input type="time" id="hora" name="hora" value="<%= Denuncia.hora %>" readonly>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Dados do Denunciante</h3>
                <p class="card-description">Informações da pessoa que registrou a denúncia</p>
            </div>
            <div class="card-content">
                <div class="form-group">
                    <label for="nomeDenunciante">Nome Completo</label>
                    <input type="text" id="nomeDenunciante" name="nomeDenunciante" value="<%= Denuncia.nomedenunciante %>" readonly>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="cpf">CPF</label>
                        <input type="text" id="cpf" name="cpf" value="<%= Denuncia.cpf %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" value="<%= Denuncia.email %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="telefone">Telefone</label>
                        <input type="text" id="telefone" name="telefone" value="<%= Denuncia.telefone %>" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label for="endereco">Endereco do Local</label>
                    <input type="text" id="endereco" name="endereco" value="<%= Denuncia.endereco %>" readonly>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Detalhes da Ocorrencia</h3>
                <p class="card-description">Informações específicas sobre a denuncia</p>
            </div>
            <div class="card-content">
                <div class="form-grid-3">
                    <div class="form-group">
                        <label for="especie">Espécie</label>
                        <select id="especie" name="especie" disabled>
                            <option value="Animais" <%= Denuncia.especie === 'Animais' ? 'selected' : '' %>>Animais</option>
                            <option value="Ambiental" <%= Denuncia.especie === 'Ambiental' ? 'selected' : '' %>>Ambiental</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="quantidade">Quantidade</label>
                        <input type="number" id="quantidade" name="quantidade" value="<%= Denuncia.quantidade %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="situacao">Situação</label>
                        <select id="situacao" name="situacao" <%= isAdminFlag ? '' : 'disabled' %>>
                            <option value="Pendente" <%= Denuncia.situacao === 'Pendente' ? 'selected' : '' %>>Pendente</option>
                            <option value="Em Análise" <%= Denuncia.situacao === 'Em Análise' ? 'selected' : '' %>>Em Análise</option>
                            <option value="Em Andamento" <%= Denuncia.situacao === 'Em Andamento' ? 'selected' : '' %>>Em Andamento</option>
                            <option value="Resolvida" <%= Denuncia.situacao === 'Resolvida' ? 'selected' : '' %>>Resolvida</option>
                            <option value="Arquivada" <%= Denuncia.situacao === 'Arquivada' ? 'selected' : '' %>>Arquivada</option>
                            <option value="Inativa" <%= Denuncia.situacao === 'Inativa' ? 'selected' : '' %>>Inativa</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="descricaoSituacao">Situação do caso</label>
                    <textarea id="descricaoSituacao" name="descricaoSituacao" rows="5" <%= isAdminFlag ? '' : 'readonly' %>><%= Denuncia.descricaoSituacao || '' %></textarea>
                </div>
                <div class="form-group">
                    <label>Arquivos e Evidências</label>
                    <%
                        const evidencias = Array.isArray(Denuncia.evidencias) && Denuncia.evidencias.length
                            ? Denuncia.evidencias
                            : (Denuncia.foto ? [Denuncia.foto] : []);
                        const imageExts = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.avif', '.bmp'];
                        const videoExts = ['.mp4', '.webm', '.ogg', '.mov', '.avi'];
                        const audioExts = ['.mp3', '.wav', '.ogg', '.m4a'];
                        const getFileName = (arquivo) => String(arquivo).split(/[\\/]/).pop();
                        const getFileUrl = (arquivo) => `/imagem/${encodeURIComponent(getFileName(arquivo))}`;
                        const getFileExt = (arquivo) => {
                            const arquivoLower = getFileName(arquivo).toLowerCase();
                            const dotIndex = arquivoLower.lastIndexOf('.');
                            return dotIndex >= 0 ? arquivoLower.slice(dotIndex) : '';
                        };
                    %>
                    <% if (evidencias.length) { %>
                        <div class="evidence-preview-grid">
                            <% evidencias.forEach((arquivo, index) => { %>
                                <% const arquivoNome = getFileName(arquivo); %>
                                <% const arquivoUrl = getFileUrl(arquivo); %>
                                <% const arquivoExt = getFileExt(arquivo); %>
                                <div class="evidence-preview-item">
                                    <strong>Arquivo <%= index + 1 %></strong>
                                    <% if (imageExts.includes(arquivoExt)) { %>
                                        <img src="<%= arquivoUrl %>" alt="Evidência <%= index + 1 %>">
                                    <% } else if (videoExts.includes(arquivoExt)) { %>
                                        <video controls src="<%= arquivoUrl %>"></video>
                                    <% } else if (audioExts.includes(arquivoExt)) { %>
                                        <audio controls src="<%= arquivoUrl %>"></audio>
                                    <% } else { %>
                                        <a class="evidence-file-link" href="<%= arquivoUrl %>" target="_blank" rel="noopener">
                                            Abrir arquivo
                                        </a>
                                    <% } %>
                                    <span title="<%= arquivoNome %>"><%= arquivoNome %></span>
                                    <% if (isAdminFlag) { %>
                                        <label class="evidence-keep-toggle">
                                            <input type="checkbox" name="manterEvidencias" value="<%= arquivo %>" checked>
                                            Manter arquivo
                                        </label>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div style="color: #6b7280; font-size: 0.9rem;">Sem foto anexada</div>
                    <% } %>
                    <% if (isAdminFlag) { %>
                        <label class="evidence-upload evidence-upload-edit" for="evidencias">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="17 8 12 3 7 8"></polyline>
                                <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            <span>Adicionar novas evidências</span>
                            <small>Fotos, vídeos, áudios, PDF ou outros documentos</small>
                            <input type="file" id="evidencias" name="evidencias" multiple>
                        </label>
                        <div class="evidence-list" id="editEvidenceList"></div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Dados do Denunciado</h3>
                <p class="card-description">Informações sobre o suspeito/responsável</p>
            </div>
            <div class="card-content">
                <div class="form-group">
                    <label for="nome">Nome do Denunciado</label>
                    <input type="text" id="nome" name="nome" value="<%= Denuncia.nome %>" readonly>
                </div>
                <div class="form-group">
                    <label for="enderecoProprietario">Endereco do Denunciado</label>
                    <input type="text" id="enderecoProprietario" name="enderecoProprietario" value="<%= Denuncia.enderecoProprietario %>" readonly>
                </div>
            </div>
        </div>

        <% if (isAdminFlag) { %>
            <div class="card">
                <div class="card-header">
                    <h3>Providências Tomadas</h3>
                    <p class="card-description">Ações realizadas pela equipe</p>
                </div>
                <div class="card-content">
                    <div class="form-group">
                        <textarea id="providencia" name="providencia" rows="5"><%= Denuncia.providencia %></textarea>
                    </div>
                </div>
            </div>
        <% } %>

        <div class="form-actions">
            <button type="button" class="btn btn-outline" onclick="window.location.href='<%= basePath %>/denuncia/lst'">Voltar</button>
            <% if (isAdminFlag) { %>
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <% } %>
        </div>
    </form>
</div>

<% if (isAdminFlag) { %>
    <script>
        const editEvidenceInput = document.getElementById('evidencias');
        const editEvidenceList = document.getElementById('editEvidenceList');

        editEvidenceInput?.addEventListener('change', () => {
            const files = Array.from(editEvidenceInput.files || []);
            if (!editEvidenceList) return;

            editEvidenceList.innerHTML = '';
            editEvidenceList.classList.toggle('has-files', files.length > 0);

            files.forEach((file, index) => {
                const item = document.createElement('div');
                const info = document.createElement('div');
                const title = document.createElement('strong');
                const name = document.createElement('span');
                const size = document.createElement('small');

                item.className = 'evidence-item';
                title.textContent = `Novo arquivo ${index + 1}`;
                name.textContent = file.name;
                name.title = file.name;
                size.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;

                info.append(title, name);
                item.append(info, size);
                editEvidenceList.appendChild(item);
            });
        });
    </script>
<% } %>

<%- include('../rodape.ejs') %>
